# Exclude walmart files
walmart*

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data directory is tracked, but ignore generated backups
!/data/
/data/ai-settings-*.zip
/data/claude-settings-*.zip
/data/dotfiles-*/

# OS
.DS_Store
Thumbs.db

# Tmux logs
tmux-*.log

# Secrets: this repo is public. Safety net for any folder (services keep their own .gitignore too).
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
!*.pub

# Node, test caches, restore leftovers
node_modules/
.pytest_cache/
.pi-restore-backup-*/
