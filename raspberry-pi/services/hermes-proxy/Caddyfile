# Puts the Hermes dashboard (127.0.0.1:9119) under /hermes on the tailnet. Hermes has no prefix setting of its own, but
# it honours X-Forwarded-Prefix (hermes_cli/dashboard_auth/prefix.py), so this only strips /hermes and adds that header.
# Chain: tailscale serve --https=8443 --set-path /hermes -> 127.0.0.1:9120/hermes -> here -> 127.0.0.1:9119
{
	admin off
	auto_https off
}

# Any Host header: tailscale serve passes the tailnet name through. Loopback only, so only tailscale reaches it.
http://:9120 {
	bind 127.0.0.1
	redir /hermes /hermes/
	handle_path /hermes/* {
		reverse_proxy 127.0.0.1:9119 {
			header_up X-Forwarded-Prefix /hermes
		}
	}
}
