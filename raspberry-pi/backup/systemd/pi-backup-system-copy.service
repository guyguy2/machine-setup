# Second copy of the system repo: restic copy from Drive to the Mac's append-only rest-server (README, "Second copy
# on the Mac"). Installed to /etc/systemd/system/ by `sudo raspberry-pi/backup/setup`; runs only the root-owned copy.
# Does nothing until a backup is newer than the last good copy.
[Unit]
Description=pi-backup: copy new system snapshots to the Mac (append-only rest-server)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-backup/pi-backup-system copy
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 3: the Mac is asleep or offline. Not a failure: the next hourly run tries again.
SuccessExitStatus=3
InaccessiblePaths=/home
ProtectSystem=strict
ReadWritePaths=-/var/lib/pi-backup -/root/.cache/restic -/root/.config/rclone
PrivateTmp=yes
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
