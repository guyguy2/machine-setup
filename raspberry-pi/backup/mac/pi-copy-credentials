#!/usr/bin/env bash
# pi-copy-credentials: runs ON THE PI. (Re)creates this Pi's two rest-server logins on the Mac (<host>-user and
# <host>-system, see pi-rest-server) and writes the repo files the copy jobs read:
#   ~/.config/pi-backup/mac-repo          (guy, 0600)   used by pi-backup copy
#   /root/.config/pi-backup/mac-repo      (root, 0600)  used by pi-backup-system copy (written with sudo)
# Each holds one line, rest:http://<user>:<password>@<mac tailnet ip>:<port>/<user>/. Passwords are random, go to
# the Mac on ssh's stdin (htpasswd -i) and are never printed. Re-running resets them (e.g. on a new Pi: the files
# aren't in the backup). Needs `ssh mac` and pi-rest-server installed on the Mac (README, "Second copy on the Mac").
# Usage: pi-copy-credentials [--user|--system] [--mac SSH_HOST] [--port N]     (default: both, ssh host mac, 8000)
set -euo pipefail
umask 077

sides=(user system) mac=mac port=8000
while (( $# )); do
  case $1 in
    --user) sides=(user) ;;
    --system) sides=(system) ;;
    --mac) shift; mac=${1:?--mac needs an ssh host} ;;
    --port) shift; port=${1:?--port needs a number} ;;
    -h|--help) sed -n '2,9s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "usage: ${0##*/} [--user|--system] [--mac SSH_HOST] [--port N]" >&2; exit 2 ;;
  esac
  shift
done

host=$(hostname -s)
ssh_mac() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$mac" "$@"; }
ip=$(ssh_mac /opt/homebrew/bin/tailscale ip -4 | head -n 1) || { echo "can't reach the Mac over ssh ($mac)" >&2; exit 3; }
[[ $ip =~ ^100\.[0-9.]+$ ]] || { echo "the Mac has no Tailscale IPv4" >&2; exit 2; }
ssh_mac test -x .local/bin/pi-rest-server || {
  echo "pi-rest-server isn't installed on the Mac: scp $(dirname "$0")/pi-rest-server $mac:.local/bin/ && ssh $mac .local/bin/pi-rest-server install" >&2
  exit 2
}

for side in "${sides[@]}"; do
  user=$host-$side
  pw=$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)
  printf '%s\n' "$pw" | ssh_mac ".local/bin/pi-rest-server add-user $user" >/dev/null
  line="rest:http://$user:$pw@$ip:$port/$user/"
  if [[ $side == user ]]; then
    install -d -m 0700 "$HOME/.config/pi-backup"
    printf '%s\n' "$line" > "$HOME/.config/pi-backup/mac-repo.new"
    mv -f "$HOME/.config/pi-backup/mac-repo.new" "$HOME/.config/pi-backup/mac-repo"
    echo "$user: wrote ~/.config/pi-backup/mac-repo"
  else
    sudo install -d -o root -g root -m 0700 /root/.config/pi-backup
    printf '%s\n' "$line" | sudo install -o root -g root -m 0600 /dev/stdin /root/.config/pi-backup/mac-repo
    echo "$user: wrote /root/.config/pi-backup/mac-repo"
  fi
done
unset pw line
echo "next: pi-backup copy-init; sudo /usr/local/lib/pi-backup/pi-backup-system copy-init (once each; then copy)"
