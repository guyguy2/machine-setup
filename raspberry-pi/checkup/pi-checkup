#!/usr/bin/env bash
# Read-only checkup of this Pi, one domain per section: prints OK / INFO / WARN lines and exits 1 if anything warns.
# Usage: pi-checkup [--warn-only] [--no-fetch] [domain...]     pi-checkup --list
# The /pi-checkup Claude Code skill runs this, then sends one agent per domain with warnings to investigate.
# It changes nothing, apart from `git fetch` in the repos domain (skip with --no-fetch) and a once-a-day npm audit
# result cached in ~/.cache/pi-checkup (packages domain).
# When a scan turns up something mechanical that this misses, add a check here rather than leaving it to an agent.
# shellcheck disable=SC2088  # "~/..." in messages is display text, not a path
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
pi=${here%/checkup}  # machine-setup/raspberry-pi

DOMAINS=(health services docker repos updates packages security agents backup drift)

# ---------- what this Pi is supposed to look like ----------
# Always-on units and timers that must be active and enabled. MAIN_ONLY prefixes are skipped on a worker Pi
# (~/.config/pi-role, as in restore.sh). hermes-gateway is the Telegram front door (the agents section reports it too).
SYSTEM_UNITS=(ssh.service docker.service tailscaled.service dreambase-cert.timer pi-backup-system.timer
  pi-backup-system-copy.timer)
USER_UNITS=(pi-status.service hermes-gateway.service dreambase.service dreambase-proxy.service dreambase-photos.timer
  rei.service rei-proxy.service rei-vault-sync.timer mail-sync.timer vault-index.timer pi-backup.timer
  pi-backup-copy.timer)
MAIN_ONLY=(dreambase rei mail hermes-gateway)
role=$(tr -d '[:space:]' 2>/dev/null < "$HOME/.config/pi-role"); role=${role:-main}
# Agent dashboards run one at a time (agent-lab), started and stopped from pi-status, so their units are disabled by
# design. name|units (the first is the main one). Their ports come from the units themselves (agent_ports).
AGENTS=("Hermes|hermes-dashboard.service hermes-proxy.service" "OpenClaw|openclaw-gateway.service")
# Ports meant to be reachable from the LAN; everything else should listen on 127.0.0.1 or the tailnet.
LAN_PORTS=(22 53 8090 8091)
# UDP: Pi-hole DNS, DreamBase's HTTP/3 (QUIC), Tailscale's WireGuard, the DHCP/DHCPv6 clients, mDNS (avahi-daemon,
# stock Raspberry Pi OS; its other UDP sockets are random query ports and are skipped).
LAN_UDP_PORTS=(53 8091 41641 68 546 5353)
# Pages on the LAN to probe, name|url; {ts} is this Pi's tailnet DNS name (connections go to 127.0.0.1). This repo is
# public, so sites with private names or paths are read from the private websites repo's sites.json (as pi-status does).
WEBSITES=()
SITES_JSON=~/dev/websites/sites.json
# Files holding credentials: must not be readable by group or others.
SECRET_FILES=(~/.hermes/.env ~/.hermes/auth.json ~/.openclaw/openclaw.json ~/dev/pihole/.env ~/.config/gh/hosts.yml
  ~/.claude/.credentials.json ~/.config/gws/client_secret.json ~/.config/gws/credentials.enc
  ~/.config/pi-backup/restic-password ~/.config/pi-backup/mac-repo)
# Pi-hole settings changed outside compose (pihole.toml "### CHANGED" without "(env)") that are expected: dns.hosts is
# the main Pi's local DNS record (restore.sh's pihole step writes it, checked below); webserver.api.pwhash is the hash of
# FTLCONF_webserver_api_password (.env); files.macvendor is the image's own.
# Any other key lives only in etc-pihole/ (the Teleporter backup), so a rebuild would lose it: move it to compose.
PIHOLE_TOML=~/dev/pihole/etc-pihole/pihole.toml
PIHOLE_UI_KEYS=(dns.hosts webserver.api.pwhash files.macvendor)
# Warnings the user has looked at and accepted, by key (shown as INFO "accepted"). Add keys here, not in your head.
ACCEPTED=()

# ---------- output ----------
warn_only=0 fetch=1 total=0 n=0
declare -A per_domain=()
if [[ -t 1 ]]; then G=$'\e[32m' Y=$'\e[33m' B=$'\e[1;34m' D=$'\e[2m' Z=$'\e[0m'; else G='' Y='' B='' D='' Z=''; fi
ok()   { (( warn_only )) || printf '  %sOK%s    %s\n' "$G" "$Z" "$*"; }
info() { (( warn_only )) || printf '  %sINFO%s  %s\n' "$D" "$Z" "$*"; }
# warn <key> <message>: the key names the check, so it can be accepted in ACCEPTED.
warn() {
  local key=$1; shift
  if [[ " ${ACCEPTED[*]} " == *" $key "* ]]; then info "accepted ($key): $*"; return; fi
  n=$((n + 1)); printf '  %sWARN%s  %s %s[%s]%s\n' "$Y" "$Z" "$*" "$D" "$key" "$Z"
}
section() { printf '%s== %s%s\n' "$B" "$1" "$Z"; }

have() { command -v "$1" >/dev/null 2>&1; }
S() { sudo -n "$@" 2>/dev/null; }  # privileged read; empty output without passwordless sudo
can_sudo() { sudo -n true 2>/dev/null; }
days_since() { echo $(( ($(date +%s) - $1) / 86400 )); }
gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
ts_name() { tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//'; }
# drive_remotes_without_client <rclone.conf>: comma-separated names of type=drive remotes with no client_id
drive_remotes_without_client() {
  awk 'function flush() { if (name != "" && type == "drive" && !cid) out = out (out ? "," : "") name }
       /^\[.*\]$/ { flush(); name = substr($0, 2, length($0) - 2); type = ""; cid = 0; next }
       /^type *= *drive *$/ { type = "drive" }
       /^client_id *= *[^ ]/ { cid = 1 }
       END { flush(); print out }' "$1"
}
# unpinned_images <compose file>: each image reference that is :latest or has no tag (one per line)
unpinned_images() {
  sed -nE 's/^[[:space:]]*image:[[:space:]]*["'"'"']?([^"'"'"' #]+).*/\1/p' "$1" | while read -r img; do
    [[ ${img##*/} == *@sha256:* ]] && continue          # pinned by digest
    if [[ ${img##*/} != *:* || $img == *:latest ]]; then echo "$img"; fi
  done
}
# links_drift < output of `restore.sh --dry-run --only links`: one line per link that is missing or taken
links_drift() {
  sed -nE -e "s#^  linked ([^ ]+) -> .*#\1 is missing#p" -e "s#^  ([^ ]+) exists and is not this repo's .*#\1 exists but isn't the repo's link#p" \
    | sed "s#^$HOME/#~/#"
}
# pihole_ui_keys < pihole.toml: dotted keys marked "### CHANGED" that weren't set by an FTLCONF_ variable ("(env)")
pihole_ui_keys() {
  awk '/^[[:space:]]*#/ { next }
       /^[[:space:]]*\[[A-Za-z.]+\][[:space:]]*$/ { sec = $0; gsub(/[][:space:][]/, "", sec); next }
       /^[[:space:]]*[A-Za-z_]+[[:space:]]*=/ { key = $0; sub(/^[[:space:]]*/, "", key); sub(/[[:space:]]*=.*/, "", key) }
       /### CHANGED/ && !/### CHANGED \(env\)/ { print sec "." key }'
}
# pihole_dns_hosts < pihole.toml: the local DNS records in [dns] hosts, one "IP name" per line
pihole_dns_hosts() {
  awk '/^[[:space:]]*#/ { next }
       /^[[:space:]]*\[[A-Za-z.]+\][[:space:]]*$/ { sec = $0; gsub(/[][:space:][]/, "", sec); next }
       sec == "dns" && /^[[:space:]]*hosts[[:space:]]*=/ { in_h = 1 }
       in_h { line = $0; done = (line ~ /\]/)
              while (match(line, /"[^"]*"/)) { print substr(line, RSTART + 1, RLENGTH - 2); line = substr(line, RSTART + RLENGTH) }
              if (done) in_h = 0 }'
}
# dns_fallback <nameserver...>: "ok" when this Pi's DNS has its own Pi-hole (127.0.0.1) and a public resolver to
# fall back on (R-034; restore.sh's pihole step sets them), else what's missing.
dns_fallback() {
  local s lo=0 pub=0
  for s in "$@"; do
    case $s in 127.0.0.1) lo=1 ;; 8.8.8.8|8.8.4.4|1.1.1.1|1.0.0.1|9.9.9.9) pub=1 ;; esac
  done
  if (( lo && pub )); then echo ok
  elif (( pub )); then echo "no Pi-hole (127.0.0.1)"
  elif (( lo )); then echo "no public fallback resolver"
  else echo "neither Pi-hole (127.0.0.1) nor a public fallback resolver"; fi
}
# dnssec_validates <dig flags line for example.com> <dig status for dnssec-failed.org>: true when Pi-hole sets the
# AD flag on a signed answer and refuses a broken signature (SERVFAIL). Google's upstreams validate too, so
# SERVFAIL alone doesn't show that Pi-hole does.
dnssec_validates() { [[ $1 =~ flags:[a-z\ ]*\ ad[\ \;] && $2 == SERVFAIL ]]; }
# days_until <date> [now epoch]: whole days from now until the date (any format `date -d` reads; negative when past)
days_until() {
  local t now=${2:-$(date +%s)}
  t=$(date -d "$1" +%s 2>/dev/null) || return 1
  echo $(( (t - now) / 86400 ))
}
# expiry_check <key> <what> <date> <warn days> <fix>: WARN when the date is under <warn days> away (or past), else OK.
expiry_check() {
  local d
  if ! d=$(days_until "$3"); then warn "$1" "$2: can't read its expiry date ($3)"
  elif (( d < 0 )); then warn "$1" "$2 expired $(( -d )) day(s) ago ($5)"
  elif (( d < $4 )); then warn "$1" "$2 expires in $d day(s), on ${3%%[T ]*} ($5)"
  else ok "$2 valid until ${3%%[T ]*} ($d days)"; fi
}
# env_value <file> <KEY>: KEY's value from a dotenv file, quotes stripped. Only ever piped into a probe, never printed.
env_value() { sed -nE "s/^[[:space:]]*(export[[:space:]]+)?$2=[\"']?([^\"']*)[\"']?[[:space:]]*$/\2/p" "$1" 2>/dev/null | tail -1; }
# curl_k <curl args...>: curl with its URL and headers read from stdin (-K -), so a token never shows in argv (ps).
curl_k() { curl -s -m 10 -K - "$@"; }
# npm_upgrades < `npm outdated -g --json`: "name current->latest" for each package whose latest is newer than what's
# installed. npm also lists a package whose installed version is newer than the newest one min-release-age allows
# (a downgrade); those are skipped. npm and corepack come with apt's nodejs.
npm_upgrades() {
  local name cur new
  jq -r 'to_entries[] | select(.key != "npm" and .key != "corepack") | "\(.key) \(.value.current // "") \(.value.latest // "")"' 2>/dev/null \
    | while read -r name cur new; do
        [[ -n $cur && -n $new && $cur != "$new" ]] || continue
        [[ $(printf '%s\n' "$cur" "$new" | sort -V | tail -1) == "$new" ]] && echo "$name $cur->$new"
      done
}
# uv_audit_result <output of uv audit>: "ok", or the summary line when it found something, or "failed: <line>"
uv_audit_result() {
  local out=$1 line
  if grep -q 'Found no known vulnerabilities' <<<"$out"; then echo ok; return; fi
  line=$(grep -v '^warning:' <<<"$out" | grep -m1 -iE 'found .*(vulnerab|adverse)')
  if [[ -n $line ]]; then echo "$line"; else echo "failed: $(grep -v '^warning:' <<<"$out" | grep -m1 . | cut -c1-100)"; fi
}
# npm_audit_counts < `npm audit --json`: "<high> <critical> <total>" (empty when the JSON has no counts)
npm_audit_counts() { jq -r '.metadata.vulnerabilities // empty | "\(.high // 0) \(.critical // 0) \(.total // 0)"' 2>/dev/null; }
# install_dups <brew prefix> <leaves, space-separated> <dir...>: "<name>: brew <formula|cask:name> and <dir>" for each
# command that a Homebrew leaf formula or cask installs and that also exists in one of the dirs (another source).
# Formulae installed only as dependencies are skipped: they sit behind /usr/bin on purpose (~/.claude/CLAUDE.md).
install_dups() {
  local prefix=$1 leaves=" $2 " f t pkg n d; shift 2
  for f in "$prefix"/bin/*; do
    t=$(readlink "$f") || continue
    case $t in
      *Cellar/*) pkg=${t#*Cellar/}; pkg=${pkg%%/*}; [[ $leaves == *" $pkg "* ]] || continue ;;
      *Caskroom/*) pkg=${t#*Caskroom/}; pkg=cask:${pkg%%/*} ;;
      *) continue ;;
    esac
    n=${f##*/}
    for d in "$@"; do [[ -e $d/$n ]] && echo "$n: brew $pkg and $d"; done
  done
  return 0
}
# local_bin_dups <dir> <dir...>: "<name>: <dir> and <other>" for each command in the first dir also in another
local_bin_dups() {
  local first=$1 f n d; shift
  for f in "$first"/*; do
    [[ -e $f ]] || continue; n=${f##*/}
    for d in "$@"; do [[ -e $d/$n ]] && echo "$n: $first and $d"; done
  done
  return 0
}
# save_sh_lists <save.sh>: the text of its dotfiles=( ) and regenerated=( ) arrays (paths save.sh covers)
save_sh_lists() { sed -n -e '/^dotfiles=(/,/^)/p' -e '/^regenerated=(/,/^)/p' "$1"; }
# main_only <unit>: true when the unit is for the main Pi only (see MAIN_ONLY)
main_only() { local p; for p in "${MAIN_ONLY[@]}"; do [[ $1 == "$p"* ]] && return 0; done; return 1; }

# unit_ports < unit text (+ any config file it loads): the local ports it serves, first-seen order, one per line.
# Matches 127.0.0.1:N / localhost:N / http://:N (Caddyfile site address) / --port N; not tailnet ports (--https=N).
unit_ports() {
  grep -oE '(127\.0\.0\.1|localhost|//):[0-9]{2,5}|--port[ =][0-9]{2,5}' | grep -oE '[0-9]+$' | awk '!seen[$0]++'
}
# agent_unit_text <unit...>: each user unit's text, plus the file its ExecStart passes to --config (e.g. a Caddyfile)
agent_unit_text() {
  local u text cfg
  for u in "$@"; do
    text=$(systemctl --user cat "$u" 2>/dev/null) || continue
    printf '%s\n' "$text"
    cfg=$(sed -nE 's/^ExecStart=.*--config[ =]([^ ]+).*/\1/p' <<<"$text" | head -1); cfg=${cfg//%h/$HOME}
    [[ -n $cfg && -r $cfg ]] && cat "$cfg"
  done
}
# agent_ports: fill AGENT_PORTS[name]="port ..." (the first is the main unit's) from each agent's units.
declare -A AGENT_PORTS=()
agent_ports() {
  local spec name units u ports
  for spec in "${AGENTS[@]}"; do
    IFS='|' read -r name units <<<"$spec"; ports=""
    for u in $units; do ports+=" $(agent_unit_text "$u" | unit_ports | paste -sd ' ')"; done
    AGENT_PORTS[$name]=$(tr ' ' '\n' <<<"$ports" | awk 'NF && !seen[$0]++' | paste -sd ' ')
  done
}
# route_agent <proxy URL>: the agent whose units serve that URL's port (empty if none)
route_agent() {
  local port=${1#*://} name
  port=${port#*:}; port=${port%%/*}
  for name in "${!AGENT_PORTS[@]}"; do [[ " ${AGENT_PORTS[$name]} " == *" $port "* ]] && { echo "$name"; return 0; }; done
  return 0
}
# serve_routes < `tailscale serve status --json`: "host path proxy" per route
serve_routes() {
  jq -r '.Web // {} | to_entries[] | .key as $h | .value.Handlers | to_entries[] | "\($h) \(.key) \(.value.Proxy // "")"'
}
# shutdown_was_clean < the last lines of the previous boot's journal (journalctl -b -1 -o cat)
shutdown_was_clean() { grep -qE 'Journal stopped|Syncing filesystems and block devices|systemd-shutdown'; }

# parse_listeners < `ss -ltunH[p]`: "proto addr port process" per socket (addr without brackets/%iface, * = all;
# process "-" when unknown)
parse_listeners() {
  local netid local_ rest addr port proc
  while read -r netid _ _ _ local_ _ rest; do
    [[ -n $local_ ]] || continue
    port=${local_##*:}; addr=${local_%:*}; addr=${addr%%\%*}; addr=${addr//[\[\]]/}
    proc=$(grep -oE '\("[^"]+",pid=[0-9]+' <<<"$rest" | head -1 | tr -d '("' | sed 's/,pid=/ pid /')
    echo "$netid $addr $port ${proc:--}"
  done
}
# listener_scope <addr>: local | tailnet | v4 (IPv4 LAN or all IPv4) | v6 (all interfaces incl. IPv6, or a global
# 2000::/3 address: reachable on the Pi's public IPv6 address unless something drops it) | lan6 (link-local/ULA)
listener_scope() {
  case $1 in
    127.*|::1) echo local ;;
    100.*|fd7a:*) echo tailnet ;;
    \*|::) echo v6 ;;
    [23][0-9a-f][0-9a-f][0-9a-f]:*) echo v6 ;;
    *:*) echo lan6 ;;
    *) echo v4 ;;
  esac
}
# host_firewall_drops < `nft list table inet host`: true when it has an input-hook chain with policy drop
host_firewall_drops() { grep -E 'hook input' | grep -q 'policy drop'; }
# root_exec_paths < `systemctl show -p Id,User,ExecStart,...` for many units: "unit path" for every absolute path in
# the commands of units that run as root (User= empty or root). Arguments count too (bash /path/script.sh).
root_exec_paths() {
  awk 'function flush() { if (id != "" && (user == "" || user == "root" || user == "0")) for (i = 1; i <= n; i++) print id, p[i]
                          id = ""; user = ""; n = 0 }
       /^$/ { flush(); next }
       /^Id=/ { id = substr($0, 4); next }
       /^User=/ { user = substr($0, 6); next }
       /^Exec[A-Za-z]*=/ { line = $0
         while (match(line, /argv\[\]=[^;]*/)) {
           k = split(substr(line, RSTART + 7, RLENGTH - 7), a, /[ \t]+/)
           for (j = 1; j <= k; j++) { t = a[j]; gsub(/^["\047]+|["\047;]+$/, "", t); if (t ~ /^\//) p[++n] = t }
           line = substr(line, RSTART + RLENGTH)
         } }
       END { flush() }' | awk '!seen[$0]++'
}
# script_exec_paths <file>: absolute paths in a script (shebang text file) that are executable files, so the script
# a root unit runs is checked one level deeper; nothing for binaries
script_exec_paths() {
  [[ $(head -c2 "$1" 2>/dev/null) == '#!' ]] || return 0
  local q
  grep -oE '(^|[^A-Za-z0-9_.$-])/[A-Za-z0-9_.+/-]+' "$1" 2>/dev/null | sed -E 's#^[^/]##' | sort -u | while read -r q; do
    [[ $q != "$1" && -f $q && -x $q ]] && echo "$q"
  done
  return 0
}
# nonroot_writable <path>: "<what> (why)" when a non-root user can change the file it resolves to, or replace it or
# a symlink to it through a directory they can write; nothing when only root can. (R-008)
nonroot_writable() {
  local q uid gid mode
  for q in "$(readlink -f "$1")" "$(readlink -f "$(dirname "$1")")"; do
    while [[ -n $q ]]; do
      if read -r uid gid mode < <(stat -c '%u %g %a' "$q" 2>/dev/null); then
        if (( uid != 0 )); then echo "$q (owned by $(id -nu "$uid" 2>/dev/null || echo "uid $uid"))"; return; fi
        if [[ -d $q ]] && (( 8#$mode & 8#1000 )); then :  # sticky (e.g. /tmp): only an entry's owner can replace it
        elif (( 8#$mode & 8#002 )); then echo "$q (world-writable)"; return
        elif (( 8#$mode & 8#020 && gid != 0 )); then echo "$q (group $(getent group "$gid" | cut -d: -f1) can write)"; return; fi
      fi
      [[ $q == / ]] && break
      q=$(dirname "$q")
    done
  done
}
# venvs_on_brew_python <dir...>: "<venv> (home)" for each .venv whose interpreter is a Homebrew Python, which brew
# upgrade + cleanup deletes (the venv then breaks). (R-087)
venvs_on_brew_python() {
  local cfg home
  while IFS= read -r cfg; do
    home=$(sed -nE 's/^home *= *//p' "$cfg" | head -1)
    [[ $home == /home/linuxbrew/* ]] && echo "${cfg%/pyvenv.cfg} ($home)"
  done < <(find "$@" -maxdepth 6 \( -name node_modules -o -name .git \) -prune -o -path '*/.venv/pyvenv.cfg' -print 2>/dev/null)
  return 0
}
# HTTP status of a URL ("000" when nothing answers); extra args go to curl.
http_code() { curl -s -o /dev/null -m 8 -w '%{http_code}' "$@" 2>/dev/null; }
listening() { ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q .; }

# ---------- health: CPU, memory, disk, temperature, kernel, logs ----------
check_health() {
  local l1 l5 l15 cores up temp th
  read -r l1 l5 l15 _ < /proc/loadavg; cores=$(nproc); up=$(uptime -p)
  if gt "$l15" "$cores"; then warn health.load "15-min load $l15 is above $cores cores ($up)"
  else ok "load $l1 / $l5 / $l15 on $cores cores, $up"; fi

  if have vcgencmd; then
    temp=$(vcgencmd measure_temp | grep -oE '[0-9.]+')
    if gt "$temp" 75; then warn health.temp "SoC at ${temp}°C (throttles at 80-85°C): check the fan/case"
    else ok "SoC ${temp}°C at $(( $(vcgencmd measure_clock arm | cut -d= -f2) / 1000000 )) MHz"; fi
    th=$(vcgencmd get_throttled | cut -d= -f2)
    if [[ $th == 0x0 ]]; then ok "never under-voltage or throttled since boot"
    else warn health.throttled "get_throttled=$th (bit 16/0 = under-voltage, 18/2 = throttled): check the power supply"; fi
  fi

  local total avail stotal sfree
  total=$(awk '/^MemTotal/ {print $2}' /proc/meminfo); avail=$(awk '/^MemAvailable/ {print $2}' /proc/meminfo)
  stotal=$(awk '/^SwapTotal/ {print $2}' /proc/meminfo); sfree=$(awk '/^SwapFree/ {print $2}' /proc/meminfo)
  if (( avail * 100 / total < 15 )); then warn health.memory "only $((avail / 1024)) MB of $((total / 1024)) MB RAM available"
  else ok "RAM $(( (total - avail) / 1024 )) MB used, $((avail / 1024)) MB available of $((total / 1024)) MB"; fi
  if (( stotal > 0 && (stotal - sfree) * 100 / stotal > 50 )); then warn health.swap "swap $(( (stotal - sfree) / 1024 )) MB of $((stotal / 1024)) MB in use"
  else ok "swap $(( (stotal - sfree) / 1024 )) MB of $((stotal / 1024)) MB in use"; fi

  local mnt pct ipct
  while read -r mnt pct ipct; do
    pct=${pct%\%} ipct=${ipct%\%}
    if (( pct > 85 )); then warn health.disk "$mnt is $pct% full"
    elif [[ $ipct != - ]] && (( ipct > 85 )); then warn health.inodes "$mnt has used $ipct% of its inodes"
    else ok "$mnt $pct% full (inodes $ipct%)"; fi
  done < <(df --output=target,pcent,ipcent / /boot/firmware 2>/dev/null | tail -n +2)

  # Pi kernels keep the same `uname -r` across updates, so compare the image's date with the boot time instead.
  local boot img
  boot=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) ))
  img=/boot/firmware/kernel_2712.img; [[ -f $img ]] || img=/boot/firmware/kernel8.img
  if [[ -f /run/reboot-required ]]; then warn health.reboot "reboot required ($(tr '\n' ' ' < /run/reboot-required.pkgs 2>/dev/null))"
  elif [[ -f $img ]] && (( $(stat -c %Y "$img") > boot )); then warn health.reboot "kernel ${img##*/} updated $(date -d @"$(stat -c %Y "$img")" '+%F %R') after boot: reboot to load it"
  else ok "running the installed kernel $(uname -r)"; fi

  if ! can_sudo; then info "journal and dmesg checks skipped (need passwordless sudo)"; return; fi
  local oom mmc
  oom=$(S journalctl -k -b -q -o cat | grep -ci 'out of memory')
  if (( oom )); then warn health.oom "$oom out-of-memory kill(s) since boot (sudo journalctl -k -b | grep -i 'out of memory')"
  else ok "no out-of-memory kills since boot"; fi
  mmc=$(S dmesg | grep -ciE 'mmc[0-9].*(error|timeout|crc)|I/O error')
  if (( mmc )); then warn health.sdcard "$mmc SD card / I/O errors in dmesg since boot (sudo dmesg | grep -iE 'mmc|I/O error')"
  else ok "no SD card or I/O errors since boot"; fi
  # A power cut or pulled cable on an SD-card root (no shutdown lines at the end of the previous boot)
  local prev last
  prev=$(S journalctl -b -1 -n 50 -q -o cat)
  if [[ -n $prev ]]; then
    last=$(S journalctl -b -1 -n 1 -q -o short-unix | cut -d. -f1)
    if shutdown_was_clean <<<"$prev"; then ok "the previous boot shut down cleanly"
    elif [[ -n $last ]] && (( $(days_since "$last") <= 7 )); then
      warn health.unclean-shutdown "the previous boot ended without a shutdown at $(date -d @"$last" '+%a %F %R') (power cut, pulled cable, PSU?): check the power; a UPS HAT would cover it"
    else info "the previous boot ended without a clean shutdown${last:+ ($(date -d @"$last" +%F))}, over a week ago"; fi
  fi
  if [[ -d /var/log/journal ]]; then ok "journal is persistent ($(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMG]'))"
  else warn health.journal "journal is in RAM only: logs of a crashed boot are lost (restore.sh system step fixes it)"; fi

  local errs top
  errs=$(S journalctl -p err --since -24h -q -o json | jq -r '._SYSTEMD_USER_UNIT // ._SYSTEMD_UNIT // .SYSLOG_IDENTIFIER // "?"' 2>/dev/null)
  if [[ -z $errs ]]; then ok "no error-level log lines in the last 24h"
  else
    top=$(sort <<<"$errs" | uniq -c | sort -rn | head -5 | awk '{printf "%s%s ×%s", sep, $2, $1; sep=", "}')
    info "$(wc -l <<<"$errs") error-level log lines in 24h: $top"
  fi
}

# ---------- services: systemd units, timers, tailnet routes, websites ----------
check_services() {
  local u state en f
  f=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'; systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
  if [[ -n ${f//[$'\n ']/} ]]; then warn services.failed "failed units: $(echo $f)"; else ok "no failed units (system or user)"; fi

  for u in "${SYSTEM_UNITS[@]}"; do
    [[ $role != main ]] && main_only "$u" && continue
    state=$(systemctl is-active "$u" 2>/dev/null); en=$(systemctl is-enabled "$u" 2>/dev/null)
    if [[ $state == active && $en == enabled ]]; then ok "$u active"; else warn services.unit "$u is $state / $en (should be active / enabled)"; fi
  done
  for u in "${USER_UNITS[@]}"; do
    [[ $role != main ]] && main_only "$u" && continue
    state=$(systemctl --user is-active "$u" 2>/dev/null); en=$(systemctl --user is-enabled "$u" 2>/dev/null)
    if [[ $state == active && $en == enabled ]]; then ok "$u (user) active"; else warn services.unit "$u (user) is $state / $en (should be active / enabled)"; fi
  done

  # Units that keep failing, even if the latest run worked (a timer that fails every 15 minutes stays "inactive").
  # "<count> <unit> <epoch of last failure>"
  local fails unit count last
  fails=$( { S journalctl --since -24h -q -o short-unix || journalctl --user --since -24h -q -o short-unix; } 2>/dev/null \
    | grep -E ": [A-Za-z0-9@._-]+\.(service|timer|socket): Failed with result" \
    | sed -E 's/^([0-9]+)\.[0-9]+ .*: ([A-Za-z0-9@._-]+\.(service|timer|socket)): Failed with result.*/\2 \1/' \
    | awk '{c[$1]++; t[$1]=$2} END {for (u in c) print c[u], u, t[u]}')
  while read -r count unit last; do
    [[ -n $unit ]] && (( count >= 3 )) || continue
    state=$(systemctl --user show -p Result --value "$unit" 2>/dev/null); [[ -n $state ]] || state=$(systemctl show -p Result --value "$unit" 2>/dev/null)
    if [[ $state == success ]] && (( $(date +%s) - last > 7200 )); then
      info "$unit failed $count times in 24h, last at $(date -d @"$last" '+%a %R'); working since"
    else warn services.flapping "$unit failed $count times in 24h, last at $(date -d @"$last" '+%a %R') (latest result: ${state:-unknown})"; fi
  done <<<"$fails"

  # Every `tailscale serve` route should have a backend that answers.
  local host path proxy code spec agent agent_off
  agent_ports
  while read -r host path proxy; do
    [[ -n $proxy ]] || continue
    code=$(http_code "$proxy")
    # an agent's route is down whenever the agent is (one runs at a time)
    agent_off="" agent=$(route_agent "$proxy")
    if [[ -n $agent ]]; then
      for spec in "${AGENTS[@]}"; do
        [[ ${spec%%|*} == "$agent" ]] || continue
        spec=${spec#*|}; systemctl --user is-active -q "${spec%% *}" || agent_off=$agent
      done
    fi
    if [[ $code == 000 || $code == 5* ]]; then
      if [[ -n $agent_off ]]; then info "tailnet :${host##*:}$path down while $agent_off is off"
      else warn services.route "tailnet https://…:${host##*:}$path -> $proxy: backend not answering (HTTP $code)"; fi
    else ok "tailnet :${host##*:}$path -> $proxy (HTTP $code)"; fi
  done < <(tailscale serve status --json 2>/dev/null | serve_routes)

  # LAN websites: answer, and their certificate isn't about to expire.
  local ts name url hp end left
  ts=$(ts_name)
  local -a sites=("${WEBSITES[@]}")
  if [[ -r $SITES_JSON ]]; then
    mapfile -t -O "${#sites[@]}" sites < <(jq -r '.[] | select(.tailnet_only | not) | "\(.name)|https://{ts}:\(.port)\(.path)"' "$SITES_JSON" 2>/dev/null)
  else info "no $SITES_JSON (the private websites repo): its sites aren't checked"; fi
  for f in "${sites[@]}"; do
    name=${f%%|*} url=${f#*|} url=${url//\{ts\}/$ts}
    hp=${url#https://}; hp=${hp%%/*}
    code=$(http_code --resolve "$hp:127.0.0.1" "$url")
    if [[ $code == 000 || $code == 5* ]]; then warn services.website "$name ($url) not answering (HTTP $code)"; continue; fi
    end=$(openssl s_client -connect "127.0.0.1:${hp##*:}" -servername "${hp%:*}" </dev/null 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    if [[ -z $end ]]; then ok "$name answers (HTTP $code)"; continue; fi
    left=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    if (( left < 14 )); then warn services.cert "$name certificate expires in $left days ($end)"
    else ok "$name answers (HTTP $code), certificate valid $left more days"; fi
  done
}

# ---------- docker: daemon, containers, compose services, images ----------
check_docker() {
  if ! systemctl is-active -q docker; then warn docker.daemon "docker.service is not running"; return; fi
  if ! docker info >/dev/null 2>&1; then warn docker.access "docker info failed (is $USER in the docker group?)"; return; fi
  ok "docker $(docker version -f '{{.Server.Version}}' 2>/dev/null) running"

  local name state status restarts
  while IFS='|' read -r name state status; do
    restarts=$(docker inspect -f '{{.RestartCount}}' "$name" 2>/dev/null)
    if [[ $state != running ]]; then warn docker.container "container $name is $state ($status)"
    elif [[ $status == *unhealthy* ]]; then warn docker.health "container $name is unhealthy ($status)"
    elif (( restarts > 3 )); then warn docker.restarts "container $name restarted $restarts times"
    else ok "container $name: $status"; fi
  done < <(docker ps -a --format '{{.Names}}|{{.State}}|{{.Status}}')

  local compose svc running
  for compose in "$pi"/services/*/docker-compose.yml; do
    [[ -f $compose ]] || continue
    running=$(docker compose -f "$compose" ps --services --status running 2>/dev/null)
    for svc in $(docker compose -f "$compose" config --services 2>/dev/null); do
      grep -qx "$svc" <<<"$running" || warn docker.compose "compose service $svc (${compose#"$pi"/}) is not running"
    done
  done

  # Every image in a compose file is pinned to a release tag: upd pulls whatever the tag points to, so :latest (or no
  # tag) would put an untested upstream release live with nothing to roll back to. (agent-lab/reviews R-084)
  local unpinned=0 img
  for compose in "$pi"/services/*/docker-compose.y*ml "$HOME"/dev/*/docker-compose.y*ml "$HOME"/dev/*/*/docker-compose.y*ml \
                 "$HOME"/dev/*/compose.y*ml "$HOME"/dev/*/*/compose.y*ml; do
    [[ -f $compose && ! -L ${compose%/*} ]] || continue
    while read -r img; do
      unpinned=1; warn docker.unpinned "${compose/#$HOME/~} uses $img: pin a release tag (bump it on purpose; upd health-checks it)"
    done < <(unpinned_images "$compose")
  done
  (( unpinned )) || ok "compose images are pinned to release tags"

  # Images no container uses: `upd` only refreshes Pi-hole's, so the rest go stale.
  local used unused
  used=$(docker ps -a -q | xargs -r docker inspect -f '{{.Image}}' 2>/dev/null)
  unused=$(docker images --no-trunc --format '{{.ID}} {{.Repository}}:{{.Tag}} {{.Size}}' | while read -r id ref size; do
    grep -qx "$id" <<<"$used" || echo "$ref ($size)"; done)
  if [[ -n $unused ]]; then warn docker.images "images no container uses: $(echo $unused | sed 's/) /), /g') (docker image rm <name>)"
  else ok "every image is in use"; fi

  # Pi-hole reports its own components' latest versions; the image tag is pinned, so a newer one means bump the tag.
  local line pinned running_img newest
  pinned=$(sed -nE 's/^ *image: *["'"'"']?(pihole\/pihole:[^"'"'"' ]+).*/\1/p' "$pi/services/pihole/docker-compose.yml" 2>/dev/null | head -1)
  if docker ps --format '{{.Names}}' | grep -qx pihole; then
    while read -r line; do
      [[ $line =~ ^([A-Za-z]+)\ version\ is\ (v[^ ]+)\ \(Latest:\ ([^\)]+)\) ]] || continue
      if [[ ${BASH_REMATCH[2]} == "${BASH_REMATCH[3]}" || ${BASH_REMATCH[3]} == null ]]; then ok "Pi-hole ${BASH_REMATCH[1]} ${BASH_REMATCH[2]} is current"
      else warn docker.pihole "Pi-hole ${BASH_REMATCH[1]} ${BASH_REMATCH[2]} < ${BASH_REMATCH[3]} (bump the image tag in ~/dev/pihole/docker-compose.yml; upd then pulls it)"; fi
    done < <(docker exec pihole pihole version 2>/dev/null)
    running_img=$(docker inspect -f '{{.Config.Image}}' pihole 2>/dev/null)
    [[ -n $pinned && $running_img != "$pinned" ]] && info "Pi-hole runs $running_img, compose pins $pinned: the next upd recreates the container (a DNS blip)"
    # DNSSEC (R-034): FTLCONF_dns_dnssec in compose. The image has dig.
    local flags status
    flags=$(docker exec pihole dig +adflag +time=3 +tries=1 @127.0.0.1 example.com 2>/dev/null | grep -m1 '^;; flags:')
    status=$(docker exec pihole dig +time=3 +tries=1 @127.0.0.1 dnssec-failed.org 2>/dev/null | sed -nE 's/.*status: ([A-Z]+).*/\1/p' | head -1)
    if dnssec_validates "$flags" "$status"; then ok "Pi-hole validates DNSSEC (AD flag on example.com, SERVFAIL on dnssec-failed.org)"
    else info "Pi-hole doesn't validate DNSSEC (example.com: '${flags#;; }', dnssec-failed.org: ${status:-no answer}; FTLCONF_dns_dnssec in ~/dev/pihole/docker-compose.yml)"; fi
  fi
  # This Pi's own DNS (R-034): MagicDNS forwards to NetworkManager's nameservers for the LAN connection; without a
  # public one there, a dead Pi-hole also takes down the Pi's backups and alerts.
  local dev ns fb
  dev=$(ip -4 route show default 2>/dev/null | sed -nE 's/.* dev ([^ ]+).*/\1/p' | head -1)
  if have nmcli && [[ -n $dev ]]; then
    ns=$(nmcli -g IP4.DNS dev show "$dev" 2>/dev/null | tr -d '|')
    fb=$(dns_fallback $ns)  # word-split on purpose
    if [[ $fb == ok ]]; then ok "this Pi's DNS: Pi-hole with a public fallback ($(echo $ns) via MagicDNS)"
    else warn docker.pi-dns "this Pi's DNS ($dev: ${ns:-none}) has $fb, so a Pi-hole outage stops its own lookups (fix: restore.sh --only pihole)"; fi
  fi
  # Newest release tag on Docker Hub (YYYY.MM.N); network, so skipped with --no-fetch.
  if (( fetch )) && [[ $pinned == *:20[0-9][0-9].* ]]; then
    newest=$(curl -s -m 10 'https://hub.docker.com/v2/repositories/pihole/pihole/tags?page_size=25&ordering=last_updated' 2>/dev/null \
      | jq -r '.results[].name' 2>/dev/null | grep -E '^20[0-9]{2}\.[0-9]{2}\.[0-9]+$' | sort -V | tail -1)
    if [[ -z $newest ]]; then info "could not read Pi-hole's tags from Docker Hub"
    elif [[ $newest != "${pinned##*:}" && $(printf '%s\n' "$newest" "${pinned##*:}" | sort -V | tail -1) == "$newest" ]]; then
      warn docker.pihole-tag "Pi-hole $newest is out, compose pins ${pinned##*:} (read the release notes, bump the tag, run upd)"
    else ok "Pi-hole image tag ${pinned##*:} is the newest release"; fi
  fi
  # Settings that live only in Pi-hole's data, not in compose (R-039), and the main Pi's local DNS record.
  if [[ -r $PIHOLE_TOML ]]; then
    local k extra=() want rec
    while read -r k; do [[ -n $k && " ${PIHOLE_UI_KEYS[*]} " != *" $k "* ]] && extra+=("$k"); done < <(pihole_ui_keys < "$PIHOLE_TOML")
    if (( ${#extra[@]} )); then warn docker.pihole-ui "Pi-hole settings changed in the UI, not in compose (a rebuild loses them; only the Teleporter backup has them): ${extra[*]} (add FTLCONF_ variables to ~/dev/pihole/docker-compose.yml)"
    else ok "Pi-hole's settings come from compose (plus the expected ${PIHOLE_UI_KEYS[*]})"; fi
    if [[ $role == main ]]; then
      want="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -nE 's/.* src ([0-9.]+).*/\1/p') $(ts_name)"
      rec=$(pihole_dns_hosts < "$PIHOLE_TOML")
      if [[ $want == " "* || $want == *" " ]]; then info "no LAN address or tailnet name: local DNS record not checked"
      elif grep -qxF "$want" <<<"$rec"; then ok "Pi-hole resolves this Pi's tailnet name to its LAN address"
      elif grep -qE " ${want#* }\$" <<<"$rec"; then warn docker.pihole-dns "Pi-hole's local DNS record for this Pi's tailnet name points at an old LAN address (fix it in the admin UI: Settings > Local DNS Records)"
      else warn docker.pihole-dns "Pi-hole has no local DNS record for this Pi's tailnet name, so LAN devices reach DreamBase only over Tailscale (fix: restore.sh --only pihole)"; fi
    fi
  fi
  info "disk: $(docker system df --format '{{.Type}} {{.Size}} ({{.Reclaimable}} reclaimable)' | paste -sd ';' | sed 's/;/; /g')"
}

# ---------- repos: git state of ~/dev, stray directories, broken links ----------
check_repos() {
  local email g d name dirty ahead behind stash oldest own f t
  email=$(git config --global user.email)
  for g in "$HOME"/dev/*/.git "$HOME"/dev/*/*/.git; do
    [[ -d $g ]] || continue
    d=${g%/.git}; [[ -L $d || -L ${d%/*} ]] && continue
    name=${d#"$HOME"/dev/}
    (( fetch )) && timeout 30 git -C "$d" fetch -q 2>/dev/null
    own=$(git -C "$d" log -1 --author="$email" --format=%h 2>/dev/null)  # repos you commit to, vs upstream clones
    dirty=$(git -C "$d" status --porcelain | wc -l)
    stash=$(git -C "$d" stash list | wc -l)
    if ! git -C "$d" rev-parse -q --verify '@{u}' >/dev/null; then warn repos.upstream "$name: branch $(git -C "$d" branch --show-current) has no upstream"; continue; fi
    read -r behind ahead < <(git -C "$d" rev-list --left-right --count '@{u}...HEAD')
    if (( dirty )); then
      oldest=$(date +%s)
      while IFS= read -r f; do
        f=${f:3}; f=${f#*-> }; f=${f%\"}; f=${f#\"}
        [[ -e $d/$f ]] && t=$(stat -c %Y "$d/$f") && (( t < oldest )) && oldest=$t
      done < <(git -C "$d" status --porcelain)
      if (( $(days_since "$oldest") >= 1 )); then warn repos.uncommitted "$name: $dirty uncommitted file(s), oldest change $(days_since "$oldest") day(s) ago"
      else info "$name: $dirty uncommitted file(s) from today (work in progress?)"; fi
    fi
    (( ahead )) && warn repos.unpushed "$name: $ahead commit(s) not pushed (a rebuild only gets what's on GitHub)"
    if (( behind )); then
      if [[ -n $own ]]; then warn repos.behind "$name: $behind commit(s) behind origin (git -C ~/dev/$name pull --ff-only)"
      else info "$name: upstream clone, $behind commit(s) behind (upd pulls every 5th run)"; fi
    fi
    (( stash )) && info "$name: $stash stash entr(y/ies)"
    (( dirty || ahead || behind || stash )) || ok "$name clean and in sync"
  done

  # Real directories in ~/dev that aren't repos are not backed up anywhere.
  for d in "$HOME"/dev/*/; do
    d=${d%/}; [[ -L $d || -e $d/.git ]] && continue
    find "$d" -mindepth 2 -maxdepth 2 -name .git -print -quit | grep -q . \
      && warn repos.untracked "~/dev/${d##*/} holds repos but isn't one; check each is pushed" \
      || warn repos.untracked "~/dev/${d##*/} is not in git, so a rebuild won't bring it back"
  done

  local broken
  broken=$(find "$HOME/dev" -maxdepth 2 -xtype l 2>/dev/null; find "$HOME/.local/bin" /usr/local/bin "$HOME/.claude/skills" -maxdepth 1 -xtype l 2>/dev/null)
  for f in $broken; do warn repos.symlink "broken symlink ${f/#$HOME/~} -> $(readlink "$f")"; done
  [[ -n $broken ]] || ok "no broken symlinks in ~/dev, ~/.local/bin, /usr/local/bin, ~/.claude/skills"

  # Project venvs must use the system (or uv-managed) Python: Homebrew Pythons arrive as other formulae's
  # dependencies, and brew upgrade + cleanup deletes the keg a venv points at. (R-087)
  local venv
  venv=$(venvs_on_brew_python "$HOME/dev")
  if [[ -n $venv ]]; then while read -r f; do warn repos.venv-python "venv ${f/#$HOME/~} uses a Homebrew Python, which brew cleanup can delete (pin .python-version, then rm -rf .venv && uv sync)"; done <<<"$venv"
  else ok "no ~/dev venv uses a Homebrew Python"; fi

  # npm run through ~/dev/<x> (a relative symlink into this repo) records bogus ../machine-setup/... paths.
  local lock c
  for lock in "$pi"/services/*/package-lock.json; do
    [[ -f $lock ]] || continue
    c=$(grep -c '^    "\.\./' "$lock")
    if (( c )); then warn repos.lockfile "${lock#"$pi"/}: $c entries with bogus ../ paths (npm ran through a symlink; regenerate from the real directory)"
    else ok "${lock#"$pi"/} has no bogus entries"; fi
  done
}

# ---------- updates: what upd would install ----------
check_updates() {
  local f=${XDG_CACHE_HOME:-$HOME/.cache}/upd-runs age list
  if [[ -f $f ]]; then
    age=$(days_since "$(stat -c %Y "$f")")
    if (( age > 7 )); then warn updates.upd "upd last ran $age days ago"; else ok "upd last ran $age day(s) ago"; fi
  else warn updates.upd "no record of upd having run"; fi

  list=$(apt list --upgradable 2>/dev/null | tail -n +2 | cut -d/ -f1)
  if [[ -n $list ]]; then warn updates.apt "$(wc -l <<<"$list") apt package(s) upgradable: $(head -8 <<<"$list" | paste -sd ' ')"
  else ok "apt: nothing to upgrade (package lists from $(date -r /var/lib/apt/lists +%F 2>/dev/null))"; fi

  if have rpi-eeprom-update && can_sudo; then
    if S rpi-eeprom-update | grep -q 'UPDATE AVAILABLE'; then warn updates.bootloader "bootloader update available (sudo rpi-eeprom-update -a, then reboot)"
    else ok "bootloader up to date"; fi
  fi

  if have brew; then
    list=$(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --formula --quiet 2>/dev/null; HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --cask --greedy --quiet 2>/dev/null)
    if [[ -n $list ]]; then warn updates.brew "Homebrew outdated: $(echo $list)"; else ok "Homebrew: nothing outdated (as of the last brew update)"; fi
  fi

  if have npm; then
    list=$(npm outdated -g --json 2>/dev/null | npm_upgrades)
    if [[ -n $list ]]; then warn updates.npm "npm -g outdated: $(echo $list)"; else ok "npm -g packages current (npm itself comes with apt's nodejs)"; fi
  fi

  if have uv; then
    list=$(uv tool list --outdated 2>/dev/null | grep -E '^[^-].*latest' || true)
    if [[ -n $list ]]; then warn updates.uv "uv tools outdated: $(echo $list)"; else ok "uv tools current"; fi
  fi

  local cur latest
  cur=$(jq -r .version "$HOME/dev/openclaw_node/node_modules/openclaw/package.json" 2>/dev/null)
  # upd leaves an agent on hold alone, so being behind is expected: no version check, no warning
  if grep -qx openclaw "$HOME/dev/agent-lab/on-hold" 2>/dev/null; then info "OpenClaw on hold, staying on ${cur:-not installed}"
  else
    latest=$(timeout 20 npm view openclaw version 2>/dev/null)
    if [[ -n $latest && $cur != "$latest" ]]; then warn updates.openclaw "OpenClaw ${cur:-not installed} < $latest"
    elif [[ -n $cur ]]; then ok "OpenClaw $cur is the latest"; fi
  fi
  if have hermes; then
    if timeout 60 hermes update --check 2>/dev/null | grep -q 'Up to date'; then ok "Hermes $(hermes --version 2>/dev/null | grep -oE 'v[0-9.]+' | head -1) is the latest"
    else warn updates.hermes "Hermes update available (hermes update --check; upd runs hermes update --yes)"; fi
  fi
}

# ---------- packages: known vulnerabilities, one source per tool, npm hardening, caches (R-091) ----------
# Unpinned compose images are in docker (docker.unpinned) and venvs on a Homebrew Python in repos (repos.venv-python).
check_packages() {
  local lock d rel out r leaves
  leaves=$(mktemp); trap 'rm -f "$leaves"; trap - RETURN' RETURN
  have brew && { HOMEBREW_NO_AUTO_UPDATE=1 brew leaves 2>/dev/null | sed 's#.*/##' | paste -sd ' ' > "$leaves"; } &  # 1.5 s
  # uv audit (OSV lookup, network; about 0.4 s per project) for every ~/dev project with a uv.lock.
  if (( fetch )) && have uv; then
    for lock in "$HOME"/dev/*/uv.lock; do
      [[ -f $lock ]] || continue
      d=${lock%/uv.lock}; rel="~/${d#"$HOME"/}"
      out=$(cd "$d" && timeout 30 uv audit --frozen 2>&1); r=$(uv_audit_result "$out")
      case $r in
        ok) ok "uv audit $rel: no known vulnerabilities" ;;
        failed:*) info "uv audit $rel ${r}" ;;
        *) warn packages.uv-audit "uv audit $rel: $r (cd $rel && uv audit --frozen; then uv lock --upgrade-package NAME)" ;;
      esac
    done
  fi

  # npm audit of openclaw_node's lockfile: about 6 s, so cached for a day (and redone when the lockfile changes).
  local nlock=$HOME/dev/openclaw_node/package-lock.json cache=${XDG_CACHE_HOME:-$HOME/.cache}/pi-checkup/npm-audit-openclaw_node.json counts high crit total
  if [[ -f $nlock ]] && have npm; then
    if (( fetch )) && { [[ ! -s $cache ]] || [[ $nlock -nt $cache ]] || (( $(days_since "$(stat -c %Y "$cache")") >= 1 )); }; then
      mkdir -p "${cache%/*}"
      (cd "${nlock%/*}" && timeout 60 npm audit --package-lock-only --json 2>/dev/null) > "$cache.new"
      if [[ -n $(npm_audit_counts < "$cache.new") ]]; then mv "$cache.new" "$cache"; else rm -f "$cache.new"; fi
    fi
    counts=$(npm_audit_counts < "$cache" 2>/dev/null)
    if [[ -z $counts ]]; then info "npm audit of ~/dev/openclaw_node: no result yet (needs the network)"
    else
      read -r high crit total <<<"$counts"
      if (( high + crit == 0 )); then ok "npm audit ~/dev/openclaw_node: $total advisories, none high or critical"
      elif grep -qx openclaw "$HOME/dev/agent-lab/on-hold" 2>/dev/null; then
        info "npm audit ~/dev/openclaw_node: $total advisories ($high high, $crit critical); OpenClaw is on hold, so update openclaw_node before lifting the hold"
      else warn packages.npm-audit "npm audit ~/dev/openclaw_node: $total advisories ($high high, $crit critical) (cd ~/dev/openclaw_node && npm audit; update openclaw)"; fi
    fi
  fi

  # One source per tool (~/.claude/CLAUDE.md): a Homebrew leaf or cask that apt, npm -g (/usr/bin) or ~/.local/bin
  # also provides, and ~/.local/bin (uv tools, Hermes) shadowing apt.
  local dups=() line
  wait
  if have brew && [[ -s $leaves ]]; then
    while read -r line; do [[ -n $line ]] && dups+=("$line"); done < <(install_dups /home/linuxbrew/.linuxbrew \
      "$(<"$leaves")" /usr/bin /usr/local/bin "$HOME/.local/bin")
  fi
  while read -r line; do [[ -n $line ]] && dups+=("$line"); done < <(local_bin_dups "$HOME/.local/bin" /usr/bin /usr/local/bin)
  if (( ${#dups[@]} )); then warn packages.duplicates "installed from two sources (keep one, see ~/.claude/CLAUDE.md): $(printf '%s; ' "${dups[@]}" | sed 's/; $//')"
  else ok "each user tool comes from one source (brew, apt, npm -g, uv)"; fi

  # npm hardening for `sudo npm install -g` (upd, restore.sh): only releases at least a week old (R-083). The
  # install-script allowlist was left out on purpose, so it isn't checked.
  if have npm; then
    out=$(S npm config get min-release-age); [[ -n $out ]] || out=$(npm config get min-release-age 2>/dev/null)
    if [[ $out =~ ^[0-9]+$ ]] && (( out >= 7 )); then ok "npm min-release-age is $out days (root's config)"
    else warn packages.npm-hardening "npm min-release-age is ${out:-unset} (want 7+): sudo npm config set min-release-age 7 --location=global"; fi
  fi

  # Caches: INFO only (R-090 is the clean-up).
  local kb
  kb=$(du -sk "$HOME/.cache" 2>/dev/null | cut -f1)
  if [[ -n $kb ]] && (( kb > 3 * 1024 * 1024 )); then info "~/.cache is $(( kb / 1024 / 1024 )) GB (brew cleanup --prune=all, uv cache prune, npm cache clean --force)"
  else ok "~/.cache is $(( ${kb:-0} / 1024 )) MB"; fi
}

# ---------- security: exposure, firewall, ssh, secrets, tailnet ----------
check_security() {
  # Listeners (TCP and UDP) on every interface (or the LAN address) that aren't meant for the LAN.
  local proto addr port proc scope allowed seen=" " v6open=" "
  while read -r proto addr port proc; do
    scope=$(listener_scope "$addr")
    [[ $scope == local || $scope == tailnet ]] && continue
    # tailscaled's WireGuard port is meant to be reachable from the internet
    [[ $scope == v6 && $proc != tailscaled* && $v6open != *" $proto/$port "* ]] && v6open+="$proto/$port "
    if [[ $proto == udp ]]; then allowed=" ${LAN_UDP_PORTS[*]} "; [[ $proc == avahi-daemon* ]] && continue
    else allowed=" ${LAN_PORTS[*]} "; fi
    [[ $allowed == *" $port "* || $seen == *" $proto/$port "* ]] && continue
    seen+="$proto/$port "
    [[ $proc == - ]] && proc="unknown process"
    warn security.listener "$proto port $port ($proc) listens on ${addr/#\*/all interfaces}, not just localhost/tailnet"
  done < <({ S ss -ltunHp || ss -ltunH; } | parse_listeners)
  [[ $seen == " " ]] && ok "only TCP ${LAN_PORTS[*]} and UDP ${LAN_UDP_PORTS[*]} are open to the LAN"

  # Ad-hoc file servers left behind by earlier sessions.
  local pid
  for pid in $(pgrep -f 'http\.server|SimpleHTTPServer|npx (http-)?serve|live-server'); do
    warn security.adhoc-server "pid $pid: $(ps -o args= -p "$pid" | cut -c1-80), up $(ps -o etime= -p "$pid" | tr -d ' '), serving $(readlink "/proc/$pid/cwd" 2>/dev/null)"
  done

  if systemctl is-active -q rpcbind.service rpcbind.socket 2>/dev/null && ! grep -qE '\snfs4?\s' /etc/fstab && [[ ! -s /etc/exports ]]; then
    warn security.rpcbind "rpcbind runs with no NFS in use (sudo systemctl disable --now rpcbind.service rpcbind.socket nfs-blkmap; sudo systemctl mask rpcbind.service rpcbind.socket nfs-blkmap)"
  fi

  # The host firewall is its own nftables table (table inet host, coexisting with Docker's and Tailscale's rules)
  # with an input chain that drops by default; any other chain with policy drop doesn't count. (R-029)
  local global6 fw=0
  global6=$(ip -6 -o addr show scope global 2>/dev/null | awk '$2 != "tailscale0" && $4 !~ /^fd/ {print $2}' | sort -u | paste -sd ' ')
  # Root units must not run anything a non-root user can change: that's a privilege escalation. (R-008)
  local unit path where bad_units=0
  local -A checked=()
  local -a units
  mapfile -t units < <(systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '$1 !~ /@\.service$/ {print $1}')
  while read -r unit path; do
    [[ -n $path && -e $path && -z ${checked[$unit $path]:-} ]] || continue
    checked[$unit $path]=1
    for f in "$path" $(script_exec_paths "$path"); do
      where=$(nonroot_writable "$f")
      [[ -n $where ]] || continue
      bad_units=1
      warn security.root-unit "$unit runs as root but ${f/#$HOME/~} can be changed by a non-root user: ${where/#$HOME/~} (install a root-owned copy, e.g. under /usr/local/lib)"
      break
    done
  done < <(systemctl show -p Id,User,ExecStart,ExecStartPre,ExecStartPost,ExecStop,ExecStopPost,ExecReload,ExecCondition "${units[@]}" 2>/dev/null | root_exec_paths)
  (( bad_units )) || ok "root services run only root-owned programs and scripts"

  if can_sudo; then
    if S nft list table inet host 2>/dev/null | host_firewall_drops; then
      fw=1; ok "host firewall (table inet host) drops unsolicited input"
    else warn security.firewall "no host firewall (no table inet host with an input chain policy drop): every LAN listener is reachable"; fi
    if [[ -n $global6 && $v6open != " " ]] && (( ! fw )); then
      warn security.ipv6-global "$(wc -w <<<"$v6open") listener(s) on all interfaces are reachable on this Pi's global IPv6 address ($global6), with no host firewall: ${v6open# }(only the router's IPv6 firewall stands between them and the internet)"
    fi
    local sshd
    sshd=$(S sshd -T)
    grep -qx 'passwordauthentication yes' <<<"$sshd" && warn security.ssh-password "sshd allows password logins"
    grep -qx 'kbdinteractiveauthentication yes' <<<"$sshd" && warn security.ssh-password "sshd allows keyboard-interactive logins"
    grep -qx 'permitrootlogin no' <<<"$sshd" || warn security.ssh-root "sshd $(grep '^permitrootlogin' <<<"$sshd") (set PermitRootLogin no)"
    grep -qx 'x11forwarding yes' <<<"$sshd" && info "sshd X11Forwarding yes (unused over SSH from the Mac?)"
    grep -qx 'passwordauthentication no' <<<"$sshd" && ok "sshd: keys only"
    local bad
    bad=$(S journalctl -u ssh --since -7d -q -o cat | grep -E 'Failed |Invalid user' | grep -oE 'from [0-9a-f.:]+' | sort | uniq -c | sort -rn | head -3)
    if [[ -n $bad ]]; then warn security.ssh-failed "failed SSH logins in 7 days: $(echo $bad)"; else ok "no failed SSH logins in 7 days"; fi
  fi

  dpkg -s unattended-upgrades >/dev/null 2>&1 && ok "unattended-upgrades installed" \
    || warn security.autoupdate "security updates arrive only when upd runs (unattended-upgrades not installed)"

  local mode bad_perm=0 file
  mode=$(stat -c %a "$HOME"); [[ $mode == 700 || $mode == 750 ]] || warn security.home "home directory is mode $mode"
  for file in "${SECRET_FILES[@]}"; do
    [[ -e $file ]] || continue
    mode=$(stat -c %a "$file")
    (( 8#$mode & 8#077 )) && { bad_perm=1; warn security.secret-perms "${file/#$HOME/~} is mode $mode (chmod 600)"; }
  done
  (( bad_perm )) || ok "credential files are private (mode 600)"

  local stale
  stale=$(tailscale status --json 2>/dev/null | jq -r --arg now "$(date -u +%s)" '.Peer // {} | .[]
    | select(.Online | not) | select(.LastSeen != null and (.LastSeen | sub("\\.[0-9]+";"") | fromdateiso8601) < (($now|tonumber) - 90*86400))
    | "\(.DNSName | split(".")[0]) (\(.LastSeen[:10]))"' 2>/dev/null)
  if [[ -n $stale ]]; then warn security.tailnet-stale "tailnet devices offline 90+ days (remove in the admin console): $(echo $stale)"
  else ok "no long-dead tailnet devices"; fi
}

# ---------- agents: Hermes and OpenClaw ----------
check_agents() {
  local spec name units port u state up=0 code
  agent_ports
  for spec in "${AGENTS[@]}"; do
    IFS='|' read -r name units <<<"$spec"
    port=${AGENT_PORTS[$name]%% *}
    state=$(systemctl --user is-active ${units%% *} 2>/dev/null)
    if [[ $state == active ]]; then
      up=$((up + 1))
      code=$(http_code "http://127.0.0.1:$port/")
      if [[ -z $port ]]; then warn agents.port "$name is running but no port found in ${units%% *} (pi-checkup's agent_ports)"
      elif [[ $code == 000 || $code == 5* ]]; then warn agents.port "$name is running but 127.0.0.1:$port does not answer (HTTP $code)"
      else ok "$name running, 127.0.0.1:$port answers (HTTP $code)"; fi
      for u in ${units#* }; do
        [[ $u == "${units%% *}" ]] && continue
        systemctl --user is-active -q "$u" || warn agents.unit "$name is up but $u is $(systemctl --user is-active "$u")"
      done
    elif [[ $state == failed ]]; then warn agents.failed "$name's ${units%% *} failed (journalctl --user -u ${units%% *} -n 50)"
    else info "$name off (${units%% *} $state; start it from pi-status when needed)"; fi
  done
  (( up )) || info "no agent dashboard running"
  # Hermes' Telegram gateway is always on (services.unit warns when it isn't), separate from the dashboards above.
  if [[ $role == main ]]; then
    if systemctl --user is-active -q hermes-gateway.service; then
      ok "Hermes Telegram gateway up (hermes-gateway.service since $(systemctl --user show -p ActiveEnterTimestamp --value hermes-gateway.service | cut -d' ' -f2-3))"
    else info "Hermes Telegram gateway is $(systemctl --user is-active hermes-gateway.service) (see services.unit)"; fi
  fi

  # Shared skills (agent-lab/skills) installed and current in every agent not on hold.
  local lab=$HOME/dev/agent-lab/bin/lab
  if [[ -x $lab ]]; then
    if "$lab" skills --check >/dev/null 2>&1; then ok "shared skills in sync"
    else warn agents.skills "shared skills out of sync (~/dev/agent-lab/bin/lab skills --check; fix: lab skills)"; fi
  fi

  # Logins the agents' tools need. `gws auth status` only reads local files, so make a real (read-only) call:
  # an OAuth app left in Testing mode has its refresh token expire after 7 days.
  local out exp
  if have gws; then
    out=$(timeout 20 gws gmail users getProfile --params '{"userId":"me"}' 2>&1)
    if grep -q emailAddress <<<"$out"; then ok "Google (gws) login works"
    elif grep -qE 'invalid_grant|expired|revoked' <<<"$out"; then warn agents.gws-login "Google (gws) token expired or revoked: Gmail tools (clean-gmail, pay-bills) fail; sign in with ~/dev/agent-lab/bin/gws-login"
    else warn agents.gws-login "Google (gws) test call failed: $(grep -m1 -iE 'error|message' <<<"$out" | cut -c1-120)"; fi
  fi
  if have gh; then gh auth status >/dev/null 2>&1 && ok "GitHub (gh) login works" || warn agents.gh-login "gh is not signed in (gh auth login)"; fi
  # rclone Drive remotes need their own OAuth client: rclone's shared one is being retired and hits quota limits.
  # Reads only section names and whether client_id is set (never the tokens).
  local rconf=~/.config/rclone/rclone.conf shared
  if [[ -r $rconf ]]; then
    shared=$(drive_remotes_without_client "$rconf")
    if [[ -n $shared ]]; then
      warn agents.rclone-client "rclone Drive remote(s) on rclone's shared OAuth client (being retired): $shared; re-sign: ~/dev/agent-lab/bin/rclone-login --remote NAME"
    else ok "rclone Drive remotes use their own OAuth client"; fi
  fi
  if have claude; then
    out=$(timeout 20 claude auth status 2>/dev/null)
    if [[ $(jq -r '.loggedIn // empty' <<<"$out" 2>/dev/null) == false ]]; then warn agents.claude-login "Claude Code is signed out (Hermes borrows its login)"
    else
      exp=$(jq -r '.loginExpiresAt // empty' <<<"$out" 2>/dev/null)
      [[ -n $exp ]] && expiry_check agents.claude-expiry "Claude Code login" "$exp" 3 "sign in again: claude, then /login"
    fi
  fi
  check_credentials
}

# Credential expiry and liveness probes (R-024). Read-only: each makes one read call or reads a status, with a
# timeout. Tokens go to curl on stdin (curl_k), never in argv or output; only ok/expiry/HTTP status is printed.
# The network probes run in parallel (about 2 s in all), then are reported in order.
check_credentials() {
  local p exp code out henv=~/.hermes/.env
  p=$(mktemp -d); trap 'rm -rf "$p"; trap - RETURN' RETURN
  have gh && { timeout 15 gh api -i /user 2>/dev/null | tr -d '\r' \
    | sed -nE 's/^github-authentication-token-expiration: *//Ip' | head -1 > "$p/gh"; } &
  if [[ -r $henv ]]; then
    { tok=$(env_value "$henv" ANTHROPIC_API_KEY); [[ -n $tok ]] && printf 'url = "https://api.anthropic.com/v1/models?limit=1"\nheader = "x-api-key: %s"\nheader = "anthropic-version: 2023-06-01"\n' "$tok" \
        | curl_k -o /dev/null -w '%{http_code}' > "$p/anthropic"; } &
    [[ $role == main ]] && { tok=$(env_value "$henv" TELEGRAM_BOT_TOKEN); [[ -n $tok ]] && printf 'url = "https://api.telegram.org/bot%s/getMe"\n' "$tok" \
        | curl_k > "$p/telegram"; } &
  fi
  have wacli && { timeout 15 wacli --read-only --json auth status > "$p/wacli" 2>/dev/null; } &
  have td && { timeout 20 td auth status > "$p/td" 2>/dev/null; } &
  have gcloud && { timeout 15 gcloud auth list --format='value(account)' 2>/dev/null | grep -c . > "$p/gcloud"; } &
  wait

  if have gh; then
    exp=$(<"$p/gh")
    if [[ -n $exp ]]; then expiry_check agents.gh-expiry "GitHub token (gh)" "$exp" 14 "make a new fine-grained token, then gh auth login"
    else info "GitHub token (gh): no expiry header (classic token, or the call failed)"; fi
  fi
  if have tailscale; then
    exp=$(tailscale status --json 2>/dev/null | jq -r '.Self.KeyExpiry // empty' 2>/dev/null)
    if [[ -n $exp ]]; then expiry_check agents.tailscale-expiry "Tailscale node key" "$exp" 14 "renew: admin console > Machines > this Pi > Renew key, or disable key expiry"
    else info "Tailscale node key: no expiry (disabled) or not signed in"; fi
  fi
  if [[ -f $p/anthropic ]]; then
    code=$(<"$p/anthropic")
    case $code in
      200) ok "Anthropic API key (Hermes) works" ;;
      401|403) warn agents.anthropic-key "Anthropic API key in ~/.hermes/.env is rejected (HTTP $code): revoked or wrong; make a new one in the console" ;;
      *) warn agents.anthropic-key "Anthropic API key probe failed (HTTP ${code:-none}; network or API trouble)" ;;
    esac
  fi
  if [[ -f $p/telegram ]]; then
    out=$(<"$p/telegram")
    if [[ $(jq -r '.ok // empty' <<<"$out" 2>/dev/null) == true ]]; then ok "Telegram bot token works (getMe)"
    elif [[ $(jq -r '.error_code // empty' <<<"$out" 2>/dev/null) == 401 ]]; then warn agents.telegram "Telegram bot token is rejected (401): revoked in @BotFather? Put the new one in ~/.hermes/.env, restart hermes-gateway"
    else warn agents.telegram "Telegram getMe probe failed (network or Telegram trouble)"; fi
  fi
  if have wacli; then
    if [[ $(jq -r '.data.authenticated // empty' < "$p/wacli" 2>/dev/null) == true ]]; then ok "WhatsApp (wacli) linked"
    else warn agents.whatsapp "WhatsApp (wacli) isn't linked (unlinked from the phone, or inactive): send-message via WhatsApp fails; re-link with wacli auth"; fi
  fi
  if have td; then
    if grep -q Authenticated "$p/td" 2>/dev/null; then ok "Todoist (td) login works"
    else warn agents.todoist "Todoist (td) isn't signed in or the check failed (td auth status; re-login needs an SSH tunnel, see the todoist skill)"; fi
  fi
  # gcloud: nothing on the Pi needs it after setup (R-021 suggests signing out); reported, not warned, until decided.
  if have gcloud; then
    out=$(<"$p/gcloud")
    (( ${out:-0} )) && info "gcloud is signed in ($out account(s)); only setup needs it (R-021: gcloud auth revoke --all)"
  fi
  return 0
}

# ---------- backup: the nightly restic backup (raspberry-pi/backup; rules live in pi-backup status, not here) ----------
check_backup() {
  local bk=$pi/backup out rc f age
  # User repo: `pi-backup status` exits 1 when the last good backup is over 36 h old or the last restic check failed.
  out=$("$bk/pi-backup" status 2>&1); rc=$?
  if (( rc == 0 )); then ok "user backup: $(head -1 <<<"$out")"
  else warn backup.user "user backup: $(grep -m1 . <<<"$out" | cut -c1-160) (details: pi-backup status)"; fi
  systemctl --user is-enabled -q pi-backup.timer 2>/dev/null || warn backup.timer "pi-backup.timer isn't enabled (pi-backup init)"

  # Chromium's profile is only copied while it isn't running; warn when the last copy is over 14 days old.
  f=$HOME/.local/state/pi-backup/last.json
  if [[ -r $f ]] && [[ $(jq -r '.items.chromium // "skipped"' "$f" 2>/dev/null) != skipped ]]; then
    age=$(jq -r '.chromium_last_ok // empty' "$f" 2>/dev/null)
    if [[ -z $age ]]; then warn backup.chromium "the lab Chromium profile has never been backed up (it's skipped while Chromium runs)"
    elif (( $(days_since "$(date -d "$age" +%s)") > 14 )); then warn backup.chromium "the lab Chromium profile was last backed up $(days_since "$(date -d "$age" +%s)") days ago (skipped while Chromium runs)"
    fi
  fi

  # System repo (root): its status file is world-readable, so the installed copy reads it without sudo.
  local sys=/usr/local/lib/pi-backup/pi-backup-system
  [[ -x $sys ]] || sys=$bk/pi-backup-system
  out=$("$sys" status 2>&1); rc=$?
  if (( rc == 0 )); then ok "system backup: $(head -1 <<<"$out")"
  else warn backup.system "system backup: $(grep -m1 . <<<"$out" | cut -c1-160)"; fi
  systemctl is-enabled -q pi-backup-system.timer 2>/dev/null || warn backup.timer "pi-backup-system.timer isn't enabled (sudo /usr/local/lib/pi-backup/pi-backup-system init)"

  # Second copy on the Mac's append-only rest-server (R-020): `copy-status` exits 1 when the last good copy is over
  # 3 days old (the Mac sleeps; the hourly copy timers catch up when it wakes) or the Mac repo needs a prune.
  out=$("$bk/pi-backup" copy-status 2>&1); rc=$?
  if (( rc == 0 )); then ok "Mac copy (user): $(grep -m1 'last good' <<<"$out" | tr -s ' ' | sed 's/^ //' | cut -c1-120)"
  else warn backup.mac-copy "Mac copy (user): $(grep -m1 -E 'verdict|no copy' <<<"$out" | sed 's/^ *//' | cut -c1-160) (details: pi-backup copy-status)"; fi
  out=$("$sys" copy-status 2>&1); rc=$?
  if (( rc == 0 )); then ok "Mac copy (system): $(grep -m1 'last ok' <<<"$out" | tr -s ' ' | sed 's/^ //' | cut -c1-120)"
  else warn backup.mac-copy "Mac copy (system): $(grep -m1 -E '^status|none yet|unknown command' <<<"$out" | cut -c1-160) (details: $sys copy-status)"; fi

  # Root runs installed copies; they must match the repo and Homebrew's rclone (re-run setup after changes).
  out=$("$bk/setup" --check 2>&1); rc=$?
  case $rc in
    0) ok "root-side copies match the repo and Homebrew's rclone" ;;
    1) warn backup.setup "root-side copies differ from the repo or rclone is newer: review, then sudo $bk/setup ($(grep -m1 . <<<"$out" | cut -c1-100))" ;;
    *) warn backup.setup "root side not installed: sudo $bk/setup" ;;
  esac
}

# ---------- drift: live machine vs the machine-setup snapshot and backups ----------
check_drift() {
  local tmp diffs f
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  if "$pi/save.sh" --to "$tmp/snap" >/dev/null 2>&1; then
    diffs=$(diff -rq "$pi/snapshot" "$tmp/snap" 2>/dev/null | sed -e "s#$pi/snapshot/##g" -e "s#$tmp/snap/##g")
    if [[ -n $diffs ]]; then
      while read -r f; do warn drift.snapshot "snapshot out of date: $f"; done <<<"$diffs"
      info "refresh with ~/dev/machine-setup/raspberry-pi/save.sh --push (upd runs it)"
    else ok "snapshot/ matches this machine"; fi
  else warn drift.snapshot "save.sh --to failed (run it by hand to see why)"; fi

  # User units and dotfiles that exist here but that save.sh doesn't back up.
  local listed
  listed=$(save_sh_lists "$pi/save.sh")
  for f in "$HOME"/.config/systemd/user/*.{service,timer} "$HOME"/.config/systemd/user/*.d "$HOME"/.zprofile "$HOME"/.zshenv; do
    [[ -e $f ]] || continue
    # A symlink into a git repo is backed up by that repo (e.g. ~/dev/websites/systemd/user)
    [[ -L $f ]] && git -C "$(dirname "$(readlink -f "$f")")" rev-parse --git-dir >/dev/null 2>&1 && continue
    f=${f#"$HOME"/}
    grep -qF "$f" <<<"$listed" || warn drift.backup "~/$f is not in save.sh's dotfiles list"
  done

  # Links restore.sh's links step makes (commands on PATH, ~/dev folders, the skill): a dry run prints "linked"
  # for each one that is missing here; the broken-symlink check can't see a link that was never made. (R-041)
  local links
  links=$(links_drift < <("$pi/restore.sh" --dry-run --only links 2>&1))
  if [[ -n $links ]]; then while read -r f; do warn drift.links "$f (fix: ~/dev/machine-setup/raspberry-pi/restore.sh --only links)"; done <<<"$links"
  else ok "restore.sh's links (commands, ~/dev folders, skill) are all in place"; fi

  if [[ $(git -C "$pi" config core.hooksPath) == .githooks ]]; then ok "machine-setup's pre-commit hook (gitleaks) is on"
  else warn drift.hooks "machine-setup's pre-commit hook (gitleaks, tailnet name, shellcheck) is off (fix: restore.sh --only links)"; fi

  local dups
  dups=$(NO_TMUX=1 zsh -ic 'print -l $path' 2>/dev/null | sort | uniq -d)
  [[ -n $dups ]] && info "PATH lists these more than once: $(echo $dups) (~/.zshrc adds them unconditionally)"

  if have brew && [[ -f $pi/snapshot/Brewfile ]]; then
    if HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --no-upgrade --file="$pi/snapshot/Brewfile" >/dev/null 2>&1; then ok "everything in the Brewfile is installed"
    else warn drift.brew "brew bundle check: Brewfile entries missing here"; fi
  fi
}

# ---------- main ----------
# Sourced (tests/): define the functions only.
(return 0 2>/dev/null) && return 0
domains=()
while (( $# )); do
  case $1 in
    --list) printf '%s\n' "${DOMAINS[@]}"; exit 0 ;;
    --warn-only) warn_only=1 ;;
    --no-fetch) fetch=0 ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option $1" >&2; exit 2 ;;
    *) [[ " ${DOMAINS[*]} " == *" $1 "* ]] || { echo "unknown domain $1 (one of: ${DOMAINS[*]})" >&2; exit 2; }; domains+=("$1") ;;
  esac
  shift
done
(( ${#domains[@]} )) || domains=("${DOMAINS[@]}")

for d in "${domains[@]}"; do
  section "$d"; n=0
  "check_$d"
  per_domain[$d]=$n; total=$((total + n))
done

summary=""
for d in "${domains[@]}"; do (( per_domain[$d] )) && summary+=" $d=${per_domain[$d]}"; done
if (( total )); then printf '\n%sWARNINGS%s%s\n' "$Y" "$Z" "$summary"; exit 1; fi
printf '\n%sALL OK%s\n' "$G" "$Z"
