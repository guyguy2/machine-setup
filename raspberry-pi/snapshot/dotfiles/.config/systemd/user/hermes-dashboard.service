[Unit]
Description=Hermes web dashboard on 127.0.0.1:9119 (HTTPS via `tailscale serve --bg --https=8443 9119`)
After=network-online.target

[Service]
ExecStart=/home/linuxbrew/.linuxbrew/bin/hermes dashboard --no-open
# User services get a minimal PATH; Hermes runs its tools from Homebrew.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/linuxbrew/.linuxbrew/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
