[Unit]
Description=Hermes web dashboard on 127.0.0.1:9119 (HTTPS via hermes-proxy.service and `tailscale serve`)
After=network-online.target
Wants=hermes-proxy.service

[Service]
ExecStart=%h/.local/bin/hermes dashboard --no-open
# User services get a minimal PATH; Hermes runs its tools from Homebrew.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/home/linuxbrew/.linuxbrew/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
